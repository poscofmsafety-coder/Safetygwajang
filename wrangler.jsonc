{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "safetygwajang",
  "main": "worker-api.js",
  "compatibility_date": "2026-09-04",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "COMMUNITY_BOARD",
        "class_name": "CommunityBoard"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v30-community-board",
      "new_sqlite_classes": [
        "CommunityBoard"
      ]
    }
  ]
}
